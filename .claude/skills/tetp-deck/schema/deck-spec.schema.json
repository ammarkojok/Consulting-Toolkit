{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TETP Deck Spec",
  "type": "object",
  "required": ["slides"],
  "properties": {
    "deck": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "language": { "enum": ["en", "ar"], "default": "en" }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/slide" }
    }
  },
  "$defs": {
    "bullet": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "required": ["text"],
          "properties": {
            "text": { "type": "string" },
            "level": { "type": "integer", "minimum": 0, "maximum": 2 },
            "bold": { "type": "boolean" }
          }
        }
      ]
    },
    "chart": {
      "type": "object",
      "required": ["kind", "series"],
      "properties": {
        "kind": { "enum": ["bar", "hbar", "stacked_bar", "stacked_bar_100", "line", "pie", "doughnut", "scatter"] },
        "categories": { "type": "array" },
        "series": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "values"],
            "properties": {
              "name": { "type": "string" },
              "values": { "type": "array" },
              "color": { "type": "string", "pattern": "^[0-9A-Fa-f]{6}$" }
            }
          }
        },
        "data_labels": { "type": "boolean" },
        "thinkcell": { "type": "boolean" },
        "name": { "type": "string" }
      }
    },
    "slide": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["cover", "agenda", "end", "kpis", "cards", "comparison", "process", "timeline", "chart", "table", "two_columns", "bullets"] },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "source": { "type": "string" },
        "notes": { "type": "string" },
        "canvas": { "enum": ["vertical", "horizontal", "wide", "split"] },
        "heading": { "type": "string" },
        "report_type": { "type": "string" },
        "date": { "type": "string" },
        "kpis": {
          "type": "array", "minItems": 2, "maxItems": 5,
          "items": {
            "type": "object", "required": ["value", "label"],
            "properties": {
              "value": { "type": ["string", "number"] },
              "label": { "type": "string" },
              "delta": { "type": "string" },
              "accent": { "type": "string", "pattern": "^[0-9A-Fa-f]{6}$" }
            }
          }
        },
        "cards": {
          "type": "array", "minItems": 2, "maxItems": 6,
          "items": {
            "type": "object", "required": ["heading"],
            "properties": {
              "heading": { "type": "string" },
              "body": { "type": ["string", "array"] },
              "accent": { "type": "string", "pattern": "^[0-9A-Fa-f]{6}$" }
            }
          }
        },
        "left": { "type": "object" },
        "right": { "type": "object" },
        "steps": {
          "type": "array", "minItems": 2, "maxItems": 6,
          "items": {
            "type": "object", "required": ["heading"],
            "properties": {
              "heading": { "type": "string" },
              "body": { "type": ["string", "array"] }
            }
          }
        },
        "milestones": {
          "type": "array", "minItems": 2, "maxItems": 8,
          "items": {
            "type": "object", "required": ["date", "label"],
            "properties": {
              "date": { "type": "string" },
              "label": { "type": "string" },
              "done": { "type": "boolean" }
            }
          }
        },
        "chart": { "$ref": "#/$defs/chart" },
        "takeaways": { "type": "array", "items": { "$ref": "#/$defs/bullet" } },
        "takeaways_heading": { "type": "string" },
        "columns": { "type": "array", "maxItems": 6 },
        "rows": { "type": "array", "maxItems": 9 },
        "bullets": { "type": "array", "items": { "$ref": "#/$defs/bullet" } },
        "two_column": { "type": "boolean" }
      }
    }
  }
}
